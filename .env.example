# Copy to .env and fill in. Values already present in the environment win over this file.

# Base URL of the CCX deployment (no trailing /api)
CCX_BASE_URL=https://ccx.example.com

# Admin user login (k8s secret `admin-users`, ADMIN_USERS="email:password").
# Needed for datastores, users, audit, billing and cmon version.
CCX_ADMIN_USERNAME=admin@example.com
CCX_ADMIN_PASSWORD=

# Optional: HTTP basic auth (k8s secret `admin-basic-auth`,
# ADMIN_AUTH_USERNAME / ADMIN_AUTH_PASSWORD). Only the health check,
# the datastore/user counters and the VPC listing accept it.
CCX_ADMIN_BASIC_USERNAME=
CCX_ADMIN_BASIC_PASSWORD=

# Block destructive tools (delete datastore, delete/suspend user). Default true.
CCX_PROTECT=true
