{
  "name": "@severalnines/ccx-admin-mcp",
  "version": "0.1.0",
  "description": "MCP server for the CCX admin API (SRE / operations) via AI assistants",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/severalnines/ccx-admin-mcp.git"
  },
  "homepage": "https://github.com/severalnines/ccx-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/severalnines/ccx-admin-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ccx",
    "admin",
    "sre",
    "database",
    "severalnines"
  ],
  "bin": {
    "ccx-admin-mcp": "./build/index.js"
  },
  "files": [
    "build"
  ],
  "publishConfig": {
